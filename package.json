{
  "name": "blitzmemo",
  "private": true,
  "version": "0.6.2",
  "description": "Cross-platform voice input with transcription and translation.",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "main": "dist/main.js",
  "scripts": {
    "lint:quick": "eslint .",
    "build:core": "node scripts/build.mjs",
    "build": "npm run lint && npm run build:core",
    "build:release:core": "node scripts/build.mjs --release",
    "build:release": "npm run lint && npm run build:release:core",
    "build:watch": "node scripts/build.mjs --watch",
    "lint": "eslint . && npm run typecheck",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ci:local": "npm run lint && npm run build:core",
    "release:check": "node scripts/check-release.mjs",
    "deps:status": "node scripts/deps-status.mjs",
    "deps:upgrade:minor": "node scripts/deps-upgrade-minor.mjs",
    "deps:upgrade:security": "node scripts/deps-upgrade-security.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "package": "npm run build:release && node scripts/package.mjs",
    "package:macwin": "npm run build:release && node scripts/package-macwin.mjs",
    "package:macwin:zip": "npm run build:release && node scripts/package-macwin.mjs --zip",
    "package:win": "npm run package -- --platform=win32 --arch=x64 --keep-locales=en-US,ja",
    "package:win:split": "npm run package:win && node scripts/split-zip.mjs --platform=win32 --arch=x64 --max-mb=90",
    "package:win:arm64": "npm run package -- --platform=win32 --arch=arm64 --keep-locales=en-US,ja",
    "package:win:arm64:split": "npm run package:win:arm64 && node scripts/split-zip.mjs --platform=win32 --arch=arm64 --max-mb=90",
    "start": "npm run build && node scripts/start.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^19.1.0",
    "@eslint/js": "^9.39.4",
    "@eslint/json": "0.14.0",
    "@types/node": "^22.19.17",
    "electron": "^40.8.5",
    "esbuild": "^0.25.10",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.58.2"
  }
}
